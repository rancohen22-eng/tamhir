# סביבת הרצה: development (SQLite) או production (Oracle Autonomous)
NODE_ENV=development

# סוד לחתימת ה-session cookie (יש להחליף לערך אקראי חזק בפרודקשן)
SESSION_SECRET=change-me-to-a-long-random-string

# פורט השרת
PORT=3000

# --- SQLite (development) ---
# SQLITE_FILE=./data.dev.sqlite

# --- Oracle Autonomous Database (production) ---
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=your-password
# ORACLE_CONNECT_STRING=arkiafr_high
# TNS_ADMIN=/path/to/wallet   # תיקיית ה-wallet שהורדתם מ-OCI (מכילה tnsnames.ora)
