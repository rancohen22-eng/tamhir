# סביבת הרצה: development (SQLite) או production (Oracle Autonomous)
NODE_ENV=development

# סוד לחתימת ה-session cookie (יש להחליף לערך אקראי חזק בפרודקשן)
SESSION_SECRET=change-me-to-a-long-random-string

# פורט השרת
PORT=3000

# --- SQLite (development) ---
# SQLITE_FILE=./data.dev.sqlite

# --- Oracle Autonomous Database (production) ---
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=your-db-password
# ORACLE_CONNECT_STRING=arkiafr_high          # שם TNS מתוך tnsnames.ora שב-wallet
# TNS_ADMIN=C:\Users\User\wallet              # תיקיית ה-wallet שחולצה (tnsnames.ora + ewallet.pem)
# ORACLE_WALLET_PASSWORD=your-wallet-password # הסיסמה שהזנת בעת הורדת ה-wallet מ-OCI
