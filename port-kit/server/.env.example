# Copy to .env and fill in. NEVER commit the real .env — use the org secret store.
PORT=8080
# Public base URL the app is reached at (used in emails: approve link + tracking pixel)
APP_BASE_URL=https://bookings.internal.arkia.local

# PostgreSQL
DATABASE_URL=postgres://arkia:CHANGEME@db-host:5432/arkia

# Internal SMTP / Exchange relay
SMTP_HOST=smtp.internal.arkia.local
SMTP_PORT=587
SMTP_SECURE=false          # true for 465, false for 587 STARTTLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=bookings@arkia.co.il

# Security tuning
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MIN=15
SESSION_DAYS=30
MIN_PASSWORD_LEN=8
